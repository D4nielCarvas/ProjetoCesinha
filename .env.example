# ==============================================================================
# NEXUS PROJETOS - VARIÁVEIS DE AMBIENTE
# ==============================================================================

# Ambiente de Execução (development | production)
NODE_ENV=production

# Porta do Servidor (no Render é preenchida automaticamente)
PORT=3000

# Chave Secreta para Assinatura dos Tokens JWT (mínimo de 32 caracteres seguros)
JWT_SECRET=coloque_aqui_uma_chave_secreta_longa_e_aleatoria_com_mais_de_32_caracteres

# String de Conexão com o Supabase (PostgreSQL)
# Obtenha em: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Exemplo: postgresql://postgres.[project-ref]:[SUA_SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:[SENHA_DO_BANCO]@[HOST_SUPABASE]:6543/postgres?sslmode=require
