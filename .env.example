# ==============================================================================
# PROJETO CESINHA - MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================

NODE_ENV=development
PORT=3000

# Chave JWT de alta entropia para autenticação e assinatura de tokens
JWT_SECRET=coloque_aqui_uma_chave_secreta_longa_e_aleatoria_com_mais_de_32_caracteres
JWT_EXPIRES_IN=24h

# URL base da aplicação
APP_URL=http://localhost:3000

# Credenciais do Supabase (Cloud Database)
# Obtenha em: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua_service_role_ou_anon_key

# Configuração de E-mail SMTP (Opcional - para recuperação de senha)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-aplicativo
